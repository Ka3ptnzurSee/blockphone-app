{
  "expo": {
    "name": "InternetBlocker",
    "slug": "internetblocker",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0d12",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meister.internetblocker",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "InternetBlocker"
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.meister.internetblocker",
      "adaptiveIcon": {
        "backgroundColor": "#0b0d12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "74e49a11-9b0c-44a8-a9e9-f786efb18325"
      }
    },
    "owner": "per2004"
  }
}
